{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"types": ["$app/types", "svelte", "vite/client", "@types/bun", "vitest/globals"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"sourceMap": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte",
		"functions/**/*.ts",
		"tests/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
