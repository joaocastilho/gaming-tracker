{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["vite/client", "@types/bun", "vitest/globals"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"sourceMap": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"functions/**/*.ts",
		"scripts/devApiPlugin.ts",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
