{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["vite/client", "@types/bun", "vitest/globals"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"sourceMap": true
	},
	"include": [
		"src/app.d.ts",
		"src/Document.tsx",
		"src/App.tsx",
		"src/router.tsx",
		"src/lib/types/**/*.ts",
		"src/lib/constants/**/*.ts",
		"src/lib/db.ts",
		"src/lib/stores/**/*.ts",
		"src/lib/utils/**/*.ts",
		"src/lib/components/detail-modal/SwipeController.ts",
		"src/lib/components/detail-modal/continuumGestures.ts",
		"src/lib/components/detail-modal/continuumNeighbors.ts",
		"functions/**/*.ts",
		"tests/setup.ts",
		"tests/solid-toolchain-smoke.test.tsx",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
