{
	"name": "gaming-tracker",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"check:watch": "tsc --noEmit --watch",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"generate-favicons": "bun scripts/generate-favicons.ts",
		"optimize-covers": "bun scripts/optimize-covers-full.ts",
		"optimize-logo": "bun scripts/optimize-logo.ts",
		"test:game-management": "vitest run tests/test-game-management.test.ts",
		"test:data-persistence": "vitest run tests/test-data-persistence.test.ts",
		"test:browser-navigation": "vitest run tests/test-browser-navigation.test.ts",
		"test:theme-switching": "vitest run tests/test-theme-switching.test.ts",
		"test:unit": "vitest run",
		"test:cover-loading": "vitest run tests/test-cover-loading.test.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:functions": "bunx wrangler@3.114.17 pages functions build --outdir .wrangler/functions-build",
		"validate": "bun run lint:fix && bun run format && bun run check && bun run test",
		"clean": "bun -e \"const fs = require('fs'); ['node_modules', 'dist', 'build', '.wrangler', 'bun.lock'].forEach(f => fs.rmSync(f, { recursive: true, force: true }));\" && bun install"
	},
	"dependencies": {
		"@chenglou/pretext": "1.0.0",
		"@lucide/solid": "^1.77.0",
		"@solidjs/meta": "^2.0.0",
		"@solidjs/router": "^2.0.1",
		"@solidjs/web": "^2.0.3",
		"chart.js": "^4.6.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"dexie": "^4.4.7",
		"solid-js": "^2.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@solidjs/testing-library": "1.0.0-rc.2",
		"@solidjs/vite-plugin": "^3.0.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"fake-indexeddb": "^6.2.8",
		"happy-dom": "21.0.4",
		"jsdom": "30.0.1",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
